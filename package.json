{
  "name": "dagar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "seed": "node --no-warnings scripts/seed.ts",
    "check:keys": "node --no-warnings scripts/check-arithmetic-keys.ts",
    "check:streaks": "node --no-warnings scripts/check-streaks.ts",
    "db:types": "npx supabase gen types typescript --linked > /tmp/dagar-db-types.ts && grep -q 'export type Database' /tmp/dagar-db-types.ts && mv /tmp/dagar-db-types.ts lib/supabase/database.types.ts || (echo 'db:types FAILED \u2014 database.types.ts left untouched' && cat /tmp/dagar-db-types.ts && exit 1)",
    "translate:hi": "node --no-warnings scripts/translate-hindi.ts",
    "check:hindi": "node --no-warnings scripts/check-hindi.ts",
    "icons": "node --no-warnings scripts/generate-icons.ts",
    "verify:answers": "node --no-warnings scripts/verify-answer-keys.ts",
    "demo:data": "node --no-warnings scripts/demo-data.ts",
    "feedback:export": "node --no-warnings scripts/export-feedback.ts",
    "deck": "python3 scripts/gen-architecture-diagram.py && python3 scripts/gen-persona-illustration.py && python3 scripts/build-deck.py && python3 scripts/build-how-doc.py",
    "deck:preview": "python3 scripts/preview-deck.py /tmp/deck-preview",
    "viz:preview": "node --no-warnings scripts/gen-viz-preview.ts",
    "deck:shots": "node --no-warnings scripts/capture-screens.ts",
    "deck:pdf": "node --no-warnings scripts/build-pdfs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "clsx": "^2.1.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
