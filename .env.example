# Saathi — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# Every variable here must ALSO be added in the Vercel dashboard on Day 0 (D0.6).

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=            # Project URL — Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon/public key — Supabase > Settings > API
SUPABASE_SERVICE_ROLE_KEY=           # SERVER ONLY — service role key, same page.
                                     # Bypasses RLS. Only lib/supabase/admin.ts may
                                     # read this. Never import that file into a
                                     # client component.

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                   # SERVER ONLY — console.anthropic.com > API keys

# ─── Twilio WhatsApp (parent summaries, D4) ──────────────────────────────────
TWILIO_ACCOUNT_SID=                  # SERVER ONLY — console.twilio.com
TWILIO_AUTH_TOKEN=                   # SERVER ONLY — console.twilio.com
TWILIO_WHATSAPP_FROM=                # SERVER ONLY — sandbox number, format: whatsapp:+14155238886
                                     # Sandbox only in MVP. The parent must send
                                     # "join <code>" to this number once before any
                                     # message can be delivered to them.

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=                # http://localhost:3000 locally; the Vercel URL in prod.
                                     # Used for Supabase OAuth redirect and the parent
                                     # summary deep link. Wrong value = Google Sign-In
                                     # returns to the wrong host and silently fails.
CRON_SECRET=                         # SERVER ONLY — any long random string. Guards the
                                     # weekly parent-summary cron route so it cannot be
                                     # triggered by an outsider.
# ─── Web push (daily reminders, D17b) ────────────────────────────────────────
# Generate ONCE with:  npx web-push generate-vapid-keys
#
# NEVER REGENERATE after learners have subscribed. A subscription is bound to
# the keypair that created it, so a new pair breaks every existing one —
# silently. No error; notifications simply stop arriving.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=        # PUBLIC on purpose. The browser needs it to
                                     # verify a push came from us. This is the one
                                     # place NEXT_PUBLIC_ on a "key" is correct.
VAPID_PRIVATE_KEY=                   # SERVER ONLY — signs each send. Never prefix
                                     # this one with NEXT_PUBLIC_.
VAPID_SUBJECT=                       # SERVER ONLY — a URI the push service can use
                                     # to reach the sender. `mailto:you@example.com`
                                     # or `https://dagar-ap19.vercel.app`. The scheme
                                     # is required; a bare address is rejected.

ADMIN_EMAILS=                        # SERVER ONLY — comma-separated. Who may open
                                     # /admin/metrics, which aggregates every learner's
                                     # activity. FAILS CLOSED: unset or empty means
                                     # nobody gets in, including you. Never prefix with
                                     # NEXT_PUBLIC_ — that would ship the list of admin
                                     # addresses to every browser.

# ─── Not used in MVP ─────────────────────────────────────────────────────────
# SMS is blocked by India's TRAI DLT registration (D4). The adapter ships as a
# stub. Do not add Twilio SMS credentials expecting delivery to Indian numbers.
